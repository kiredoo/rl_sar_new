<?xml version="1.0" ?>
<sdf version="1.5">
    <world name="default">

        <physics type="ode">
            <max_step_size>0.0005</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>2000</real_time_update_rate>
            <gravity>0 0 -9.81</gravity>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>50</iters>
                    <sor>1.3</sor>
                </solver>
                <constraints>
                    <cfm>0.0</cfm>
                    <erp>0.2</erp>
                    <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
                    <contact_surface_layer>0.001</contact_surface_layer>
                </constraints>
            </ode>
        </physics>

        <scene>
            <sky>
                <clouds>
                    <speed>12</speed>
                </clouds>
            </sky>
        </scene>

        <include>
            <uri>model://sun</uri>
        </include>
        <include>
            <uri>model://ground_plane</uri>
        </include>

        <!--
            Corridor: 100 inches = 2.54 m interior width along Y axis.
            Left wall inner face  at Y = -1.27 m
            Right wall inner face at Y = +1.27 m
            Robot walks in +X direction.

            Staircase: 10 steps, rise=0.18 m, tread=0.28 m, width=66 in=1.6764 m.
            Adjacent to LEFT wall: left edge at Y=-1.27 m, center Y=-0.4318 m.
            Starts at X=3.0 m. Full-column geometry (solid from ground up).
        -->

        <!-- Left wall: 20 m long, 0.3 m thick, 3 m tall; inner face at Y=-1.27 -->
        <model name="left_wall">
            <static>true</static>
            <link name="link">
                <pose>7 -1.42 1.5 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box><size>20 0.3 3.0</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>20 0.3 3.0</size></box>
                    </geometry>
                    <material>
                        <ambient>0.75 0.75 0.75 1</ambient>
                        <diffuse>0.75 0.75 0.75 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Right wall: 20 m long, 0.3 m thick, 3 m tall; inner face at Y=+1.27 -->
        <model name="right_wall">
            <static>true</static>
            <link name="link">
                <pose>7 1.42 1.5 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box><size>20 0.3 3.0</size></box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box><size>20 0.3 3.0</size></box>
                    </geometry>
                    <material>
                        <ambient>0.75 0.75 0.75 1</ambient>
                        <diffuse>0.75 0.75 0.75 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!--
            Staircase: single link, 10 collision/visual pairs.
            Width = 66 in = 1.6764 m; adjacent to left wall (left edge at Y=-1.27).
            Center Y = -1.27 + 1.6764/2 = -0.4318 m.
            Step i: center_x = 3.14 + i*0.28, center_y = -0.4318,
                    center_z = (i+1)*0.09, height = (i+1)*0.18
        -->
        <model name="staircase">
            <static>true</static>
            <link name="link">
                <pose>0 0 0 0 0 0</pose>

                <!-- Step 0: x=3.14, z_center=0.09, height=0.18 -->
                <collision name="step_0">
                    <pose>3.14 -0.4318 0.09 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.18</size></box></geometry>
                </collision>
                <visual name="step_0">
                    <pose>3.14 -0.4318 0.09 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.18</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

                <!-- Step 1: x=3.42, z_center=0.18, height=0.36 -->
                <collision name="step_1">
                    <pose>3.42 -0.4318 0.18 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.36</size></box></geometry>
                </collision>
                <visual name="step_1">
                    <pose>3.42 -0.4318 0.18 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.36</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

                <!-- Step 2: x=3.70, z_center=0.27, height=0.54 -->
                <collision name="step_2">
                    <pose>3.70 -0.4318 0.27 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.54</size></box></geometry>
                </collision>
                <visual name="step_2">
                    <pose>3.70 -0.4318 0.27 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.54</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

                <!-- Step 3: x=3.98, z_center=0.36, height=0.72 -->
                <collision name="step_3">
                    <pose>3.98 -0.4318 0.36 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.72</size></box></geometry>
                </collision>
                <visual name="step_3">
                    <pose>3.98 -0.4318 0.36 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.72</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

                <!-- Step 4: x=4.26, z_center=0.45, height=0.90 -->
                <collision name="step_4">
                    <pose>4.26 -0.4318 0.45 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.90</size></box></geometry>
                </collision>
                <visual name="step_4">
                    <pose>4.26 -0.4318 0.45 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 0.90</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

                <!-- Step 5: x=4.54, z_center=0.54, height=1.08 -->
                <collision name="step_5">
                    <pose>4.54 -0.4318 0.54 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.08</size></box></geometry>
                </collision>
                <visual name="step_5">
                    <pose>4.54 -0.4318 0.54 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.08</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

                <!-- Step 6: x=4.82, z_center=0.63, height=1.26 -->
                <collision name="step_6">
                    <pose>4.82 -0.4318 0.63 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.26</size></box></geometry>
                </collision>
                <visual name="step_6">
                    <pose>4.82 -0.4318 0.63 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.26</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

                <!-- Step 7: x=5.10, z_center=0.72, height=1.44 -->
                <collision name="step_7">
                    <pose>5.10 -0.4318 0.72 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.44</size></box></geometry>
                </collision>
                <visual name="step_7">
                    <pose>5.10 -0.4318 0.72 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.44</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

                <!-- Step 8: x=5.38, z_center=0.81, height=1.62 -->
                <collision name="step_8">
                    <pose>5.38 -0.4318 0.81 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.62</size></box></geometry>
                </collision>
                <visual name="step_8">
                    <pose>5.38 -0.4318 0.81 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.62</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

                <!-- Step 9: x=5.66, z_center=0.90, height=1.80 -->
                <collision name="step_9">
                    <pose>5.66 -0.4318 0.90 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.80</size></box></geometry>
                </collision>
                <visual name="step_9">
                    <pose>5.66 -0.4318 0.90 0 0 0</pose>
                    <geometry><box><size>0.28 1.6764 1.80</size></box></geometry>
                    <material>
                        <script>
                            <uri>file://media/materials/scripts/gazebo.material</uri>
                            <name>Gazebo/CeilingTiled</name>
                        </script>
                        <ambient>1 1 1 1</ambient>
                    </material>
                </visual>

            </link>
        </model>

    </world>
</sdf>
